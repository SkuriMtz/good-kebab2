# Copia este archivo como .env.local y llena los valores. Nunca subas .env.local al repositorio.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dirección pública del sitio (para el enlace de entrada por correo)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IA (solo servidor)
ANTHROPIC_API_KEY=
ATENDEL_AI_MODEL=claude-sonnet-5-5
